# Trade Scout local environment. Copy to `.env` and fill in.
# `.env` is gitignored and MUST stay that way.
#
# Nothing here is required. Sleeper, FantasyCalc, KeepTradeCut, and
# DynastyProcess all work without credentials. Leagues are configured with
# `trade-scout setup`, not here.

# ---- Flock Fantasy (optional) ------------------------------------------
# If you have a Flock Fantasy account, its rankings and trade calculator can
# be used as an additional second opinion. Uses your own login via a headless
# browser; also needs the optional browser dependency:
#   uv sync --extra flock
#   uv run playwright install chromium
FLOCK_EMAIL=
FLOCK_PASSWORD=
